# Direct GGUF inference in this Python process. Set an absolute path for your model.
AGENT_MODEL_PATH=models/qwen3-8b/Qwen3-8B-Q4_K_M.gguf
AGENT_MODEL_NAME=qwen3-8b-q4_k_m
AGENT_MEMORY_DB_PATH=.local/agent_memory.sqlite3
AGENT_CONTEXT_LENGTH=4096
AGENT_GPU_LAYERS=-1
# Windows CUDA wheel için gerekirse CUDA DLL klasörü (cudart/cublas içeren).
# AGENT_CUDA_DLL_DIRECTORY=C:/path/to/cuda/bin
AGENT_LLM_MAX_TOKENS=512
AGENT_LLM_TIMEOUT_SECONDS=120
AGENT_LLM_TEMPERATURE=0.2
# Kamuya açık bilgi sorularında başlık tr.wikipedia.org adresine gönderilir.
AGENT_WEB_LOOKUP_ENABLED=true
AGENT_LOG_LEVEL=INFO
